# Alleen nodig als je lokaal (buiten Portainer) wil testen.
# Als je via Portainer's stack-formulier werkt, vul je deze variabelen
# daar rechtstreeks in en heb je dit bestand niet nodig.

# Lokale API key: UniFi Network -> Settings -> Control Plane -> Integrations
UNIFI_HOST=https://192.168.1.1
UNIFI_API_KEY=jouw_unifi_api_key_hier
UNIFI_SITE_ID=default
UNIFI_VERIFY_SSL=false

# Home Assistant (alleen-lezen tools). Token: HA -> profiel -> Beveiliging -> Long-lived access tokens
HA_URL=http://192.168.1.104:8123
HA_TOKEN=jouw_ha_token_hier
